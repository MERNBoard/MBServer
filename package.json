{
  "name": "mbserver",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "repository": "https://github.com/MERNBoard/MBServer.git",
  "author": "9erikSantos6 <9xerix6@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "yarn typecheck && tsup src/server.ts --format esm --clean --minify --no-sourcemap --target node20",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome format",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/http-status-codes": "1.2.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mongoose": "5.11.97",
    "@types/node": "25.2.1",
    "biome": "0.3.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.1.6",
    "zod": "4.3.6"
  }
}
